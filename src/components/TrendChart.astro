---
// TrendChart.astro — 生态增长趋势图（SVG 图形 + HTML 标签层，字体与全站一致）
import { formatCompactNumber } from '../lib/catalog'
import { catalogData } from '../lib/catalog-data'
import trendData from '../data/trend-data.json'

// 过去 30 天新增插件数（趋势解读用）
const _seriesAll = (trendData.countSeries ?? []) as { date: string; count: number }[]
const _last30 = _seriesAll.slice(-30)
const _last30New = _seriesAll.length > 31 ? _last30[_last30.length - 1].count - _last30[0].count : 0

const catalog = catalogData as unknown as { stats?: { verified?: number; projectTypes?: Record<string, number> } }
const verifiedCount = catalog.stats?.verified ?? 0
const skillCount = catalog.stats?.projectTypes?.skill ?? 0
const totalStars = trendData.totalStars ?? 0

// 只显示最近6个月数据
const _sixMonthsAgo = new Date(); _sixMonthsAgo.setMonth(_sixMonthsAgo.getMonth() - 6)
const _cutoffStr = _sixMonthsAgo.toISOString().slice(0,10)
const series = (trendData.countSeries ?? []).filter((p: {date:string}) => p.date >= _cutoffStr)
const W = 760
const H = 240
const PAD_L = 46
const PAD_R = 44
const PAD_T = 16
const PAD_B = 30

const hasData = series.length > 1
const maxCount = hasData ? Math.max(...series.map((p) => p.count)) : 0
// 友好刻度：向上取整到整百/整千
const rawMax = Math.max(maxCount, 10)
const niceStep = rawMax > 2000 ? 500 : 200
const maxVal = Math.ceil(rawMax / niceStep) * niceStep

// X 轴：时间 → 像素
const t0 = hasData ? new Date(series[0].date).getTime() : 0
const t1 = hasData ? new Date(series[series.length - 1].date).getTime() : 1
const span = Math.max(1, t1 - t0)
const x = (t: number) => PAD_L + ((t - t0) / span) * (W - PAD_L - PAD_R)
const y = (v: number) => PAD_T + (1 - v / maxVal) * (H - PAD_T - PAD_B)

// 数量曲线点
const countPoints = series.map((p) => `${x(new Date(p.date).getTime()).toFixed(1)},${y(p.count).toFixed(1)}`).join(' ')

// Y 轴刻度（4 段）
const yTicks = [0, 0.25, 0.5, 0.75, 1].map((f) => Math.round(maxVal * f))
// X 轴月份刻度（按月去重 + 最小 90px 间隔过滤）
const xTicks: { label: string; px: number }[] = []
if (hasData) {
  const seen = new Set<string>()
  const rawTicks: { label: string; px: number }[] = []
  for (let i = 0; i < series.length; i++) {
    const month = series[i].date.slice(0, 7)
    if (!seen.has(month)) {
      seen.add(month)
      rawTicks.push({ label: month, px: x(new Date(series[i].date).getTime()) })
    }
  }
  let lastPx = -Infinity
  for (const t of rawTicks) {
    if (lastPx === -Infinity || t.px - lastPx > 90) {
      xTicks.push(t)
      lastPx = t.px
    }
  }
  const last = series[series.length - 1].date
  const lastLabel = last.slice(0, 7)
  if (!xTicks.length || xTicks[xTicks.length - 1].label !== lastLabel) {
    xTicks.push({ label: lastLabel, px: x(new Date(last).getTime()) })
  }
}

const latest = series[series.length - 1]
const isToday = (latest?.date ?? '') === new Date().toISOString().slice(0, 10)

// 里程碑点
const milestones: { label: string; px: number; py: number; value: number; date: string }[] = []
if (hasData) {
  const find = (target: number) => {
    const p = series.find((q) => q.count >= target)
    return p ? { value: target, date: p.date, px: x(new Date(p.date).getTime()), py: y(p.count) } : null
  }
  const m1 = find(1)
  if (m1) milestones.push({ ...m1, label: 'first' })
  const m100 = find(100)
  if (m100 && m100.date !== m1?.date) milestones.push({ ...m100, label: '100' })
  const m500 = find(500)
  if (m500 && m500.date !== m100?.date) milestones.push({ ...m500, label: '500' })
  const lastM = { value: latest.count, date: latest.date, px: x(new Date(latest.date).getTime()), py: y(latest.count) }
  milestones.push({ ...lastM, label: 'Today' })
}

// 右侧标注：500 里程碑（放最右侧，不在曲线中间）
const m500Label = milestones.find((m) => m.label === '500') ?? null
// 今日标签（最新点上方）
const mLast = milestones.length ? milestones[milestones.length - 1] : null

// HTML 标签层坐标（百分比）
const pct = (px: number) => `${((px / W) * 100).toFixed(2)}%`
const pctY = (py: number) => `${((py / H) * 100).toFixed(2)}%`
---

{
  hasData && (
    <section class="trend-chart" aria-label="Ecosystem growth">
      <div class="container trend-chart__inner">
        <div class="trend-chart__head">
          <p class="mono-label" data-i18n="trend.mono">DSH UNIVERSE / Ecosystem growth</p>
          <span class="trend-chart__live" data-i18n={isToday ? 'trend.live' : 'trend.near'}>{isToday ? '实时更新' : '近况'}</span>
        </div>
        <dl class="trend-chart__summary">
            <div>
              <dt data-i18n="trend.sumPlugins">插件</dt>
              <dd>{latest?.count ?? 0}</dd>
            </div>
            <div>
              <dt data-i18n="trend.sumVerified">已验证</dt>
              <dd>{verifiedCount}</dd>
            </div>
            <div>
              <dt data-i18n="trend.sumSkills">技能</dt>
              <dd>{skillCount}</dd>
            </div>
            <div>
              <dt data-i18n="trend.sumStars">Stars</dt>
              <dd>{formatCompactNumber(totalStars)}</dd>
            </div>
          </dl>
        <div class="trend-chart__plot">
                    <svg viewBox={`0 0 ${W} ${H}`} class="trend-chart__svg" role="img" aria-label="Plugin count growth">
            <defs>
              <linearGradient id="trend-fill" x1="0" y1="0" x2="0" y2="1">
                <stop offset="0%" stop-color="var(--accent)" stop-opacity="0.35" />
                <stop offset="100%" stop-color="var(--accent)" stop-opacity="0.02" />
              </linearGradient>
            </defs>

            <!-- 水平网格 -->
            {yTicks.map((v) => (
              <line x1={PAD_L} y1={y(v)} x2={W - PAD_R} y2={y(v)} stroke="var(--outline)" stroke-width="1" stroke-dasharray="3 5" />
            ))}

            <!-- 虚线坐标轴 -->
            <line x1={PAD_L} y1={PAD_T} x2={PAD_L} y2={H - PAD_B} stroke="var(--outline-strong)" stroke-width="1.2" stroke-dasharray="4 4" />
            <line x1={PAD_L} y1={H - PAD_B} x2={W - PAD_R} y2={H - PAD_B} stroke="var(--outline-strong)" stroke-width="1.2" stroke-dasharray="4 4" />

            <!-- 数量曲线填充 -->
            <polygon
              points={`${PAD_L},${H - PAD_B} ${countPoints} ${x(t1)},${H - PAD_B}`}
              fill="url(#trend-fill)"
            />
            <!-- 数量曲线描边 -->
            <polyline
              points={countPoints}
              fill="none"
              stroke="var(--accent)"
              stroke-width="2.5"
              stroke-linecap="round"
              stroke-linejoin="round"
            />

            <!-- 里程碑圆点 -->
            {milestones.slice(0, -1).map((m) => (
              <circle cx={m.px} cy={m.py} r="3.5" fill="var(--canvas)" stroke="var(--accent)" stroke-width="2" />
            ))}
            <circle cx={milestones[milestones.length - 1].px} cy={milestones[milestones.length - 1].py} r="5" fill="var(--accent)" stroke="var(--canvas)" stroke-width="2" />
          </svg>

          <!-- HTML 标签层（浏览器原生字体渲染，与全站一致） -->
          <div class="tc-labels" aria-hidden="true">
            {yTicks.map((v) => (
              <span class="tc-y" style={`top: ${pctY(y(v))}`}>{v}</span>
            ))}
            {xTicks.map((tick) => (
              <span class="tc-x" style={`left: ${pct(tick.px)}`}>{tick.label}</span>
            ))}
            {mLast && (
              <span class="tc-m tc-m--today" style={`left: ${pct(mLast.px)}; top: ${pctY(mLast.py)}`}>
                Today {mLast.value}
              </span>
            )}
            {m500Label && (
              <span class="tc-m tc-m--right" style={`left: ${pct(m500Label.px)}; top: ${pctY(m500Label.py)}`}>
                {m500Label.label}
              </span>
            )}

          </div>
        </div>

        <div class="trend-chart__latest">
          <span class="trend-chart__latest-note"><span data-i18n="trend.fromStart">从</span> {series[0].date} <span data-i18n="trend.started">的 1 个插件起步，持续增长</span></span>
          <span class="trend-chart__latest-label"><span data-i18n="trend.asOf">截至</span> {latest.date}</span>
        </div>
        <div class="trend-chart__cta-row">
          <p class="trend-chart__note">
            <span data-i18n="trend.note">过去 30 days新增</span>
            <strong>{_last30New}</strong>
            <span data-i18n="trend.note2">个插件，生态持续增长</span>
          </p>
          <a class="trend-chart__cta" href="/submit/" data-i18n="trend.cta">加入生态 →</a>
        </div>
      </div>
    </section>
  )
}

<style>
  .trend-chart {
    padding-block: 8px 28px;
  }

  .trend-chart__inner {
    padding: 24px 0;
    border: 0;
    border-top: 1px solid var(--outline);
    border-bottom: 1px solid var(--outline);
    border-radius: 0;
    background: transparent;
  }

  .trend-chart__head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    margin-bottom: 12px;
  }

  .trend-chart__live {
    padding: 3px 10px;
    border: 1px solid var(--outline);
    border-radius: 9999px;
    color: var(--accent);
    font-size: 12px;
    font-weight: 600;
  }

  .trend-chart__summary {
    display: flex;
    gap: 0;
    margin: 0 0 16px;
    border: 1px solid var(--outline);
    border-radius: 12px;
    background: var(--canvas-card);
    overflow: hidden;
    width: fit-content;
  }
  .trend-chart__summary div {
    min-width: 100px;
    padding: 12px 20px;
    text-align: center;
  }
  .trend-chart__summary div + div {
    border-left: 1px solid var(--outline);
  }
  .trend-chart__summary dt {
    font-size: 12px;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--mute);
    margin-bottom: 3px;
  }
  .trend-chart__summary dd {
    font-size: 23px;
    font-weight: 800;
    color: var(--ink);
    margin: 0;
    line-height: 1.1;
  }

  .trend-chart__plot {
    position: relative;
    width: 100%;
  }

  .trend-chart__svg {
    display: block;
    width: 100%;
    height: auto;
  }

  /* HTML 标签层 */
  .tc-labels {
    position: absolute;
    inset: 0;
    pointer-events: none;
    font-family: var(--font-sans);
  }

  .tc-y {
    position: absolute;
    right: calc(100% - 46px);
    transform: translateY(-50%);
    font-size: 11px;
    color: var(--mute);
    line-height: 1;
    text-align: right;
    padding-right: 6px;
  }

  .tc-x {
    position: absolute;
    top: 87.5%;
    transform: translateX(-50%);
    font-size: 11px;
    color: var(--mute);
    line-height: 1;
    margin-top: 3px;
    white-space: nowrap;
  }

  .tc-m {
    position: absolute;
    font-size: 11.5px;
    font-weight: 600;
    color: var(--body);
    background: var(--canvas-card);
    border: 1px solid var(--outline);
    border-radius: 6px;
    padding: 3px 8px;
    white-space: nowrap;
    box-shadow: var(--shadow-card);
    line-height: 1.2;
  }
  .tc-m--today {
    transform: translate(-50%, calc(-100% - 12px));
  }
  .tc-m--right {
    transform: translate(8px, -50%);
  }

  .trend-chart__latest {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 16px;
    margin-top: 14px;
    flex-wrap: wrap;
  }
  .trend-chart__latest-label {
    font-size: 13px;
    font-weight: 700;
    color: var(--ink);
  }
  .trend-chart__latest-note {
    font-size: 12px;
    font-weight: 700;
    color: var(--body);
  }

  .trend-chart__cta-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    margin-top: 14px;
    padding-top: 14px;
    border-top: 1px solid var(--outline);
    flex-wrap: wrap;
  }

  .trend-chart__note {
    display: flex;
    align-items: baseline;
    gap: 8px;
    font-size: 14px;
    color: var(--body);
    margin: 0;
  }
  .trend-chart__note strong {
    font-size: 20px;
    font-weight: 800;
    color: var(--accent);
  }

  .trend-chart__cta {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 10px 22px;
    border-radius: 999px;
    background: linear-gradient(135deg, var(--accent), var(--accent-strong));
    color: #ffffff;
    font-size: 14px;
    font-weight: 600;
    text-decoration: none;
    transition: all 0.2s ease-in;
    box-shadow: 0 6px 16px -8px var(--glow);
  }
  .trend-chart__cta:hover {
    transform: translateY(-2px);
    filter: brightness(1.06);
  }

  @media (max-width: 860px) {
    .trend-chart__summary {
      width: 100%;
    }
    .trend-chart__summary div {
      flex: 1;
      min-width: 0;
      padding: 10px 8px;
    }
    .trend-chart__summary dd {
      font-size: 19px;
    }
    .tc-y {
      right: calc(100% - 40px);
    }
    .trend-chart__cta-row {
      flex-direction: column;
      align-items: flex-start;
    }
  }
</style>
